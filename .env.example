# TecRec Universal — environment variables
# Copy to .env.local and fill in real values. Never commit real secrets.
#   cp .env.example .env.local

# ─────────────────────────────────────────────────────────────────────────────
# AI provider (chat-completions API) — REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# API key sent as `Authorization: Bearer <key>`.
AI_API_KEY=

# Full URL of the chat-completions endpoint (standard chat-completions wire format).
AI_API_URL=https://api.example.com/v1/chat/completions

# Optional model overrides. Defaults live in src/lib/env.ts.
AI_DECODE_MODEL=zai-org-glm-4.7
AI_SCAN_MODEL=qwen3-vl-235b-a22b

# Optional comma-separated extra fallback models, appended after the built-in
# fallback chain. Nothing to configure to use the defaults.
AI_DECODE_FALLBACKS=
AI_SCAN_FALLBACKS=

# Optional JSON object merged into the primary model's request body only (not
# the fallbacks). Use it for provider-specific knobs (for example live web search).
# Must be a valid JSON object, e.g. {"provider_feature":{"enabled":true}}
AI_EXTRA_BODY_JSON=

# Optional request timeout in milliseconds (default: 25000, clamped 3000–60000).
AI_TIMEOUT_MS=25000

# ─────────────────────────────────────────────────────────────────────────────
# Database (Neon serverless Postgres) — REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Pooled connection string, e.g. postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Quota / abuse limits
# ─────────────────────────────────────────────────────────────────────────────

# Optional but strongly recommended: random string used to salt client-IP
# hashes. Use a long random value and keep it stable in production.
IP_HASH_SALT=

# Paid AI calls allowed per hashed IP per UTC day (default: 5).
AI_DAILY_LIMIT_PER_IP=5

# Global paid AI calls allowed per UTC day across all IPs (default: 500).
# This is a circuit breaker: once exhausted, the API returns 503 until the
# next UTC day.
AI_GLOBAL_DAILY_LIMIT=500

# ─────────────────────────────────────────────────────────────────────────────
# Site / SEO
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin used by sitemap, robots, canonical tags and OG metadata.
# REQUIRED for Vercel production deployments — the build fails loudly without
# it. Local dev falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Amazon affiliate tag appended to server-built Amazon search links.
# Leave empty for plain, untagged links.
AMAZON_AFFILIATE_TAG=

# ─────────────────────────────────────────────────────────────────────────────
# Admin (optional)
# ─────────────────────────────────────────────────────────────────────────────

# When set, enables DELETE /api/admin/product (send it as a bearer token).
# Leave empty to disable the admin endpoint entirely.
ADMIN_TOKEN=
