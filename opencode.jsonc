{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "AGENTS.md",
    "tecrec_v2_master_prompt.md"
  ],

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "doom_loop": "allow",

    "task": "allow",

    "external_directory": {
      "*": "allow"
    },

    "edit": {
      "*.env*": "allow",
      "*.env.local*": "allow",
      "*.env.production*": "allow",
      "*.env.development*": "allow",
      "**/.env*": "allow",
      ".gitignore": "allow",
      ".git/config": "deny",
      "*": "allow"
    },

    "bash": {
      "*": "allow",
      "git reset --hard *": "deny",
      "git reset --hard": "deny",
      "git push --force*": "deny",
      "git push --delete*": "deny",
      "git push origin --delete*": "deny",
      "git push origin :*": "deny",
      "git clean *": "deny",
      "rm -rf /*": "deny",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf .": "deny",
      "rm -rf ../*": "deny",
      "npm publish": "deny",
      "npm publish *": "deny",
      "npm unpublish *": "deny",
      "yarn publish": "deny",
      "npm deprecate *": "deny",
      "sudo *": "deny",
      "curl * | bash": "deny",
      "curl * | sh": "deny",
      "wget * -O - | bash": "deny",
      "wget * -O - | sh": "deny",
      "eval *": "deny",
      "shutdown *": "deny",
      "reboot": "deny",
      "init 0": "deny",
      "init 6": "deny",
      "heroku config:set *": "deny",
      "vercel env add": "deny",
      "vercel env pull": "deny",
      "aws s3 rm *": "deny",
      "aws rds delete-*": "deny",
      "docker system prune": "deny",
      "docker system prune *": "deny"
    },

    "repo_clone": "allow"
  },

  "experimental": {
    "primary_tools": ["edit"]
  }
}